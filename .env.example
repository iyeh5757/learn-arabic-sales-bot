# Required on Vercel for real customer drafts. XAI_API_KEY wins when both are present.
# Without a key, Assist says Grok is not connected and does not invent a sales reply.
XAI_API_KEY=
GROK_API_KEY=
GROK_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Daily Frankfurter USD→EGP mid rate, cached for the Africa/Cairo calendar day.
# EGP package price = USD package price × this rate. AED is a fixed list price.
FRANKFURTER_URL=https://api.frankfurter.dev/v2/rates?base=USD&quotes=EGP

# Integration stubs. The desk does not call these providers.
# Leaving them empty is the supported state.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYMENTS_PROVIDER=
PAYMENTS_SECRET_KEY=
