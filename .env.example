# Grok drafts. Set either key. XAI_API_KEY wins when both are present.
XAI_API_KEY=
GROK_API_KEY=
GROK_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Daily USD→EGP rate. Frankfurter v1 (ECB) does not list EGP.
# v2 publishes the daily USD to EGP rate the desk multiplies by USD list prices.
FRANKFURTER_URL=https://api.frankfurter.dev/v2/rates?base=USD&quotes=EGP

# Integration stubs. The desk does not call these providers.
# Leaving them empty is the supported state.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYMENTS_PROVIDER=
PAYMENTS_SECRET_KEY=
